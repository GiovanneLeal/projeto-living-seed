{
  "ConnectionStrings": {
    // "DefaultConnection" é o apelido que damos a esse endereço.
    // Server: Onde está instalado (como é na sua máquina local, usamos o SQLEXPRESS ou o nome da sua máquina).
    // Database: O nome que o banco de dados terá lá dentro (LivingSeedDB).
    // Trusted_Connection: Diz que vamos usar a segurança do próprio Windows para logar, sem precisar colocar senha em texto limpo aqui.
    "DefaultConnection": "Server=localhost;Database=LivingSeedDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
