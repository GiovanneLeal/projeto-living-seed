## Ignorar arquivos temporários do Visual Studio, resultados de build e afins

# Arquivos específicos do usuário
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Resultados de Build (Compilação)
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Diretório de cache e opções ocultas do Visual Studio (2015 a 2022)
.vs/

# Arquivos gerados por testes
*.coverage
*.coveragexml
_Chutzpah*
_[Tt]est[Rr]esult*

# Pacotes NuGet
*.nupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# Arquivos de sistema operacional (Mac/Windows)
.DS_Store
Thumbs.db